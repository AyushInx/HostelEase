# -------------------------------------------------------------
# Hostel Complaint Tracker - Environment Configuration (.env.example)
# Secrets must NEVER be committed to version control.
# -------------------------------------------------------------

NODE_ENV=development
PORT=5000
CLIENT_ORIGIN=http://localhost:5173

# Database Connection (MongoDB)
# Local: mongodb://127.0.0.1:27017/hostel_complaints
# Atlas: mongodb+srv://<username>:<password>@cluster.mongodb.net/hostel_complaints
MONGODB_URI=mongodb://127.0.0.1:27017/hostel_complaints

# Session & Token Security
# Use a strong, random 32+ character string in production
JWT_SECRET=replace_with_a_secure_random_jwt_secret_min_32_chars
COOKIE_SECRET=replace_with_a_secure_cookie_signer_secret

# Primary Hostel Admin Bootstrap (SPEC Invariant)
# Read strictly by seed script; no public registration endpoint creates an admin.
INITIAL_ADMIN_NAME=Campus Chief Admin
INITIAL_ADMIN_EMAIL=admin@iitp.ac.in
INITIAL_ADMIN_PASSWORD=replace_with_strong_admin_password_2026!

# Escalation Engine Configuration
# Tier 2 triggers after this configurable grace period (in minutes) following Tier 1
TIER2_GRACE_PERIOD_MINUTES=120

# Resend Email Delivery (Production)
# 1. Obtain your API key from https://resend.com/api-keys
# 2. For custom domains (e.g. noreply@yourdomain.com), verify DNS records (DKIM, SPF, MX) in Resend.
# 3. For local evaluation with test accounts, use Resend's test sender: onboarding@resend.dev (sends only to your registered account).
RESEND_API_KEY=re_replace_with_your_actual_resend_api_key
EMAIL_FROM=HostelEase <noreply@your-verified-domain.com>

# Keyed HMAC Secret for 6-Digit OTP Verifier (SPEC Invariant)
# Low-entropy 6-digit OTPs are protected against offline dictionary brute force via HMAC-SHA256 with this secret.
OTP_SECRET=replace_with_a_secure_random_otp_secret_min_32_chars
PREVIOUS_OTP_SECRET=optional_previous_secret_for_zero_downtime_key_rotation


# -------------------------------------------------------------
# Hostel Complaint Tracker - Environment Configuration (.env.example)
# Secrets must NEVER be committed to version control.
# -------------------------------------------------------------

NODE_ENV=development
PORT=5000
CLIENT_ORIGIN=http://localhost:5173

# Database Connection (MongoDB)
# Local: mongodb://127.0.0.1:27017/hostel_complaints
# Atlas: mongodb+srv://<username>:<password>@cluster.mongodb.net/hostel_complaints
MONGODB_URI=mongodb://127.0.0.1:27017/hostel_complaints

# Session & Token Security
# Use a strong, random 32+ character string in production
JWT_SECRET=replace_with_a_secure_random_jwt_secret_min_32_chars
COOKIE_SECRET=replace_with_a_secure_cookie_signer_secret

# Primary Hostel Admin Bootstrap (SPEC Invariant)
# Read strictly by seed script; no public registration endpoint creates an admin.
INITIAL_ADMIN_NAME=Campus Chief Admin
INITIAL_ADMIN_EMAIL=admin@campus.edu
INITIAL_ADMIN_PASSWORD=replace_with_strong_admin_password_2026!
